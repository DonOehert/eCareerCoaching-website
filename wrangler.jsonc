{
  "name": "ecareercoaching-website",
  "compatibility_date": "2026-08-08",
  // The Worker answers /api/resume-check; everything else is served from ./public as before.
  "main": "src/worker.js",
  // Builds the blog (content/blog/*.md -> public/blog/) before every deploy.
  "build": { "command": "node scripts/build-blog.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
